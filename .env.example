# Host ports
HTTP_PORT=8080
DIRECTUS_PORT=8055

# PostgreSQL
POSTGRES_DB=fizyoterapi
POSTGRES_USER=directus
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Directus bootstrap
DIRECTUS_SECRET=replace-with-at-least-32-random-characters
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DIRECTUS_PUBLIC_URL=http://localhost:8055
